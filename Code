% P7 - Scaling and Rotation of an Image

img = imread('P5-Image.jpg');

% Scaling (resize half and double)
img_half = imresize(img,0.5); %Scale down
img_double = imresize (img,2); %scale up

%Rotation
img_rot45 = imrotate(img,45);
img_rot90 = imrotate(img,90);

% Display results
figure;

subplot(2,3,1);
imshow(img);
title('Original');

subplot(2,3,2);
imshow(img_half);
title('Scaled 0.5x');

subplot(2,3,3);
imshow(img_double);
title('Scaled 2x');

subplot(2,3,4);
imshow(img_rot45);
title('Rotated 45*');

subplot(2,3,5);
imshow(img_rot90);
title('Rotated 90*');
